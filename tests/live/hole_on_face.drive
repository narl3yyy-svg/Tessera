# Live: H (Hole), click the cylinder, Clear, click its side half way up: one
# radial hole there; OK.
waitfor tsr.feature.extrude
wait 500
vclick 0.05 0.95
key h
waitfor panelOk
wait 400
wclick 0 -10 10               # a first position (front of the cylinder)
wait 600
click clearPoints             # Clear empties the positions
wait 400
wclick 10 0 20                # the cylinder's side, half way up
wait 600
shot /tmp/live_hole_face.png
click panelOk
wait 600
