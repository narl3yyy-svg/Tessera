# Live: the Text tool. Click two corners of the text box, type the text in
# the panel (height 10 mm), Enter.
waitfor tsr.sketch.create
click tsr.sketch.create
plane XY
waitfor sketch.line
wait 500
menu sketch.group-text sketch.text
sclick 10 10
sclick 45 25
waitfor sketchText
wait 300
type TO
click textHeight
key ctrl+a
type 10 mm
key Return
wait 500
key Escape
shot /tmp/live_sketch_text.png
click palette.finish
wait 600
