# Live: Assemble > Rigid Group from its ribbon button; click the block and the
# pin, OK: the two are locked together (listed with the joints).
waitfor tsr.assemble.rigidGroup
wait 800
click tsr.assemble.rigidGroup
waitfor panelOk
wait 400
wclick 65 20 30        # block: top face
wait 300
wclick -25 15 10       # pin: top face
wait 300
shot /tmp/live_rigid_group.png
click panelOk
wait 600
shot /tmp/live_rigid_group_after.png
